# Copy values for a configured environment; scripts/dev.py init generates local credentials.
SJL_ENVIRONMENT=local
SJL_DATABASE_URL=postgresql+psycopg://sjlerp:CHANGE_ME@127.0.0.1:15432/sjlerp
SJL_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:16379/0
SJL_DB_PASSWORD=CHANGE_ME
SJL_REDIS_PASSWORD=CHANGE_ME
SJL_STORAGE_PATH=../../.local/storage
SJL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# LAN: set 0.0.0.0 and add http://<this-computer-ip>:5173 to SJL_ALLOWED_ORIGINS.
SJL_WEB_HOST=127.0.0.1
SJL_COOKIE_SECURE=false
SJL_QUEUE_NAME=sjlerp
SJL_SESSION_HOURS=12
